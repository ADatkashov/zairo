# IDE
*.iml
*.ipr
*.iws
.idea/
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store

# Melos-managed workspace files (regenerated by `melos bootstrap`)
**/pubspec_overrides.yaml

# Build outputs / caches from any package or app in the workspace
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies

# Gradle (backend/, and any Flutter android/ folder)
**/.gradle/
.gradle_home/
**/wrapper/dists/

# Local machine configuration — never commit
**/local.properties

# Android release signing — the keystore and its passwords never belong in
# git, whether created locally by a dev or decoded from a GitHub Secret in
# CI (see docs/ci-cd.md's "Android release signing" section).
**/android/key.properties
**/*.jks
**/*.keystore

# Scratch space for local-only artifacts not ready/meant for git yet
# (e.g. a hand-exported Postman collection) — see docs/ci-cd.md's note
# on generating one from OpenAPI instead of hand-maintaining an export.
docs/local/
