# IDE
*.iml
*.ipr
*.iws
.idea/
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store

# Melos-managed workspace files (regenerated by `melos bootstrap`)
**/pubspec_overrides.yaml

# Build outputs / caches from any package or app in the workspace
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies

# Gradle (backend/, and any Flutter android/ folder)
**/.gradle/
.gradle_home/
**/wrapper/dists/

# Local machine configuration — never commit
**/local.properties

# Android release signing — the keystore and its passwords never belong in
# git, whether created locally by a dev or decoded from a GitHub Secret in
# CI (see docs/ci-cd.md's "Android release signing" section).
**/android/key.properties
**/*.jks
**/*.keystore
# Exception: the committed debug-signing keystores (ci-debug.keystore,
# well-known "android"/"androiddebugkey" credentials, same as Android's
# own default debug key) — deliberately checked in so every CI-built
# debug-signed release APK shares one certificate across runs, instead of
# each ephemeral runner silently generating its own throwaway
# ~/.android/debug.keystore. Without this, a fresh CI build can't be
# installed over the previous one on a real device (signature mismatch)
# without uninstalling first. Not sensitive — see each app's
# build.gradle.kts signingConfigs comment.
!apps/user_app/android/app/ci-debug.keystore
!apps/business_admin/android/app/ci-debug.keystore

# Scratch space for local-only artifacts not ready/meant for git yet
# (e.g. a hand-exported Postman collection) — see docs/ci-cd.md's note
# on generating one from OpenAPI instead of hand-maintaining an export.
docs/local/
