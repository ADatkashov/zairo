<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every real network call (backend API, Maps tiles) needs this — the
         debug-only overlay at src/debug/AndroidManifest.xml grants it for
         `flutter run`, but that overlay never applies to a release build,
         so without it here a release APK build produces a package that
         cannot make a single network request, regardless of baseUrl. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Needed by DeviceLocationService (geolocator) — "coarse" alone is
         enough for city-level search ranking, "fine" is what a real map
         screen's blue dot needs (see GoogleMapsRenderer's myLocationEnabled). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Required by local_auth_android's BiometricPrompt-based authenticate()
         call — see BiometricAuthService and docs/authentication.md. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <application
        android:label="zairo"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <!-- Real key comes from the MAPS_API_KEY env var, read by
             android/app/build.gradle.kts into this manifest placeholder —
             never hardcoded here. Empty/missing means GoogleMapsRenderer
             is never selected anyway (see maps_providers.dart), so an
             empty key here is a safe default, not a broken one. -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${mapsApiKey}"/>
        <!-- Facebook Login (flutter_facebook_auth) — real values come from
             the FACEBOOK_APP_ID/FACEBOOK_CLIENT_TOKEN env vars, same
             env-var-first/local.properties-fallback pattern as mapsApiKey
             above (see build.gradle.kts). Empty by default: the Facebook
             SDK simply fails every login attempt with an empty App ID
             rather than crashing the build — see
             docs/authentication.md's "Provider configuration" section for
             where to get real values before Facebook Login works. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="${facebookAppId}"/>
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="${facebookClientToken}"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links: zairo://app/provider/<id>, zairo://app/bookings, …
                 (every path go_router declares — see AppRoutes). Flutter hands
                 the path to the router. https App Links need a verified domain
                 and are not set up yet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="zairo" android:host="app"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- image_cropper's native crop screen — required by the plugin's own
             Android setup instructions; without it, cropping a photo throws
             an ActivityNotFoundException. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Facebook Login's own required activities — standard Facebook
             Android SDK boilerplate (facebook_app_id/fb_login_protocol_scheme
             are the same Gradle-injected placeholders as above). -->
        <activity android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"/>
        <activity android:name="com.facebook.CustomTabActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${fbLoginProtocolScheme}"/>
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
