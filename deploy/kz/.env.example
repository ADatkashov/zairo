# Copy to .env (chmod 600 .env) and fill in. NEVER commit .env.
# Generate each secret with:  openssl rand -base64 48

# --- Domain / HTTPS ---
API_DOMAIN=api.example.kz          # DNS A record must point at this server
ACME_EMAIL=you@example.kz          # Let's Encrypt notices

# --- Database (stored on this server) ---
POSTGRES_DB=zairo
POSTGRES_USER=zairo
POSTGRES_PASSWORD=

# --- Image storage (stored on this server) ---
MINIO_ROOT_USER=zairo
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=zairo-media

# --- Token signing keys: two DIFFERENT random values ---
JWT_SECRET=
PLATFORM_ADMIN_JWT_SECRET=

# --- Web origins allowed to call the API (comma-separated; empty = none, mobile apps do not need it) ---
CORS_ALLOWED_ORIGINS=

# --- Sign-in (the prod profile refuses to start while these are blank) ---
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- SMS codes. See README "Data residency": Twilio is a foreign service. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Pre-production ONLY (one fixed code lets anyone log in as any phone number):
OTP_MOCK_CODE=
OTP_ALLOWED_COUNTRIES=KZ

# --- Payments: mock = no real money. Switch to freedompay when the contract is signed. ---
PAYMENT_PROVIDER=mock
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
FREEDOMPAY_API_URL=
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=

# --- Tuning ---
BACKEND_MEM_LIMIT=1536m
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
